/**
 * LEVEL DISPOSITION (Phase 7, 2026-10-31): writes docs/planning/LEVEL-DISPOSITION-2026-10-31.md from the
 * game's own data — the table that says, for EVERY one of the 148 campaign levels, what it becomes when the
 * player-facing progression is milestones instead of numbered levels, and the 100 milestones.
 *
 * The milestones come from `src/game/restaurant/journey.ts` (one source of truth); this script only adds the
 * pay and prints the tables. `journey-qa` re-renders it and compares with the saved file, so the doc cannot
 * drift from the game. Every level is KEPT (the services are the content; nothing is deleted).
 *
 * Run: npx tsx scripts/level-disposition.mts   (rewrites the doc; throws if the table is not whole)
 */
import fs from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";

const store = new Map<string, string>();
(globalThis as unknown as { localStorage: Storage }).localStorage = {
  getItem: (k: string) => store.get(k) ?? null,
  setItem: (k: string, v: string) => void store.set(k, v),
  removeItem: (k: string) => void store.delete(k),
  clear: () => store.clear(),
  key: () => null,
  length: 0,
} as Storage;

export const DOC_PATH = "docs/planning/LEVEL-DISPOSITION-2026-10-31.md";

export async function render(): Promise<string> {
  const { LEVELS, CHAPTER_TITLES } = await import("../src/game/levels/levelDefinitions.ts");
  const { paidLevelReward } = await import("../src/game/levels/levelRewards.ts");
  const { MILESTONES, MILESTONE_COUNT, NATURAL_MILESTONES, milestoneOf, unlockEvents } =
    await import("../src/game/restaurant/journey.ts");
  const events = unlockEvents();
  const TOTAL = LEVELS.length;
  const usd = (c: number) => `$${Math.round(c / 100).toLocaleString("en-US")}`;
  const num = (id: string) => Number(/-(\d+)$/.exec(id)![1]);
  const payOf = (from: number, to: number) =>
    LEVELS.slice(from - 1, to).reduce((t, l) => t + paidLevelReward(l), 0);
  const longest = Math.max(...MILESTONES.map((m) => m.to - m.from + 1));

  const lines: string[] = [];
  lines.push(`# KnifeCraft — Level disposition and the 100 milestones (2026-10-31)`);
  lines.push(``);
  lines.push(
    `Generated by \`scripts/level-disposition.mts\` from the game's own data through \`src/game/restaurant/journey.ts\` (re-run it after any change to levels, unlocks, staff rules or chapters; \`journey-qa\` fails if this file is out of date). It is the table behind \`PHASE7-MILESTONES-PLAN-2026-10-31.md\`. **A proposal for the developer to edit**: the unlock events are real, the grouping and the names are mine.`,
  );
  lines.push(``);
  lines.push(`## Summary`);
  lines.push(``);
  lines.push(
    `- **${TOTAL} levels kept, 0 removed.** The services are the content (the recipes, pools and techniques); nothing is deleted. What changes is what the player *sees*: the next milestone, not a level number.`,
  );
  lines.push(
    `- **${NATURAL_MILESTONES} natural milestones** come straight from unlock events (systems, staff, chefs, kitchen ranks, techniques, menu, days, chapters, story). ${MILESTONE_COUNT - NATURAL_MILESTONES} **Practice** milestones were added by splitting the longest stretches (the longest first), so no milestone is more than ${longest} services long.`,
  );
  lines.push(
    `- Service pay is unchanged: each service pays what \`paidLevelReward\` says; a milestone's pay below is only the sum of its services (no bonus is added).`,
  );
  lines.push(``);
  lines.push(`## A. The ${MILESTONE_COUNT} milestones`);
  lines.push(``);
  lines.push(
    `| # | Milestone | Kind | Services | Cuisine / chapter | Also opens here | Pay of its services |`,
  );
  lines.push(`|--:|---|---|---|---|---|--:|`);
  for (const m of MILESTONES)
    lines.push(
      `| ${m.no} | ${m.name} | ${m.kind} | ${m.from === m.to ? m.to : `${m.from}–${m.to}`} (${m.to - m.from + 1}) | ${m.chapterTitle} | ${m.also.join("; ") || "—"} | ${usd(payOf(m.from, m.to))} |`,
    );
  lines.push(``);
  lines.push(`## B. Every level, and what it becomes`);
  lines.push(``);
  lines.push(
    `Role: **anchor** = finishing this service completes its milestone; **body** = a service on the way to it. Every level is **kept** (as a hidden service).`,
  );
  lines.push(``);
  lines.push(
    `| Level | Service | Type | Chapter | Pay | Milestone | Role | What opens at this level |`,
  );
  lines.push(`|--:|---|---|---|--:|---|---|---|`);
  const seen = new Set<number>();
  for (const l of LEVELS) {
    const n = num(l.id);
    const m = milestoneOf(n);
    if (seen.has(n)) throw new Error(`level ${n} twice`);
    seen.add(n);
    const opens = (events.get(n) ?? []).map((e) => e.label);
    lines.push(
      `| ${n} | ${l.title} | ${l.type} | ${CHAPTER_TITLES[l.chapter]} | ${usd(paidLevelReward(l))} | #${m.no} ${m.name} | ${n === m.to ? "anchor" : "body"} | ${[...new Set(opens)].join("; ") || "—"} |`,
    );
  }
  if (seen.size !== TOTAL) throw new Error("not every level has a disposition");
  lines.push(``);
  lines.push(
    `Check: ${TOTAL} levels, ${MILESTONES.length} milestones, every level in exactly one milestone, the last milestone ends at level ${TOTAL}.`,
  );
  return lines.join("\n") + "\n";
}

// Run as a script (not when journey-qa imports `render`).
if (process.argv[1] && import.meta.url === pathToFileURL(path.resolve(process.argv[1])).href) {
  const text = await render();
  fs.writeFileSync(path.join(process.cwd(), DOC_PATH), text, "utf8");
  console.log(`wrote ${DOC_PATH}`);
}
