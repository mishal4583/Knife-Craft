// Builds src/game/business/plateSeeds.ts: per tier, the first N plate seeds the solver can win.
// Seeds are NOT filtered by difficulty (an earlier version trimmed them to the top of each band, which hid a
// generator that was too easy); the QA measures the win rate of careless play and asserts the band.
// Run: npx tsx scripts/make-belt-seeds.mts [seedsPerTier]   (tier 4 takes about ten minutes),
// then: npx prettier --write src/game/business/plateSeeds.ts
import { writeFile } from "node:fs/promises";
import { createServer } from "vite";

const vite = await createServer({
  configFile: "vite.config.ts",
  server: { middlewareMode: true },
  appType: "custom",
  logLevel: "silent",
});
try {
  const rules = await vite.ssrLoadModule("/src/game/business/platingBelt.ts");
  const ingredients = rules.BELT_PALETTE.map((_: unknown, color: number) => ({
    id: `seed-${color}`,
    color,
  }));
  const wanted = Number(process.argv[2] ?? 300);
  const found: Record<number, number[]> = { 1: [], 2: [], 3: [], 4: [] };
  for (const tier of rules.BELT_TIERS) {
    const seeds = found[tier.id]!;
    let tried = 0;
    let carelessWins = 0;
    for (let candidate = 1; seeds.length < wanted && candidate <= wanted * 50; candidate += 1) {
      tried += 1;
      const seed =
        (Math.imul(candidate, 0x45d9f3b) ^ Math.imul(tier.id, 0x119de1f3) ^ 0x5eedb317) >>> 0;
      const round = rules.makeBeltRound(tier, ingredients, seed);
      if (rules.beltDeckProblem(round, tier) !== null) continue;
      if (!rules.solveBeltRound(round, 30000)) continue;
      seeds.push(seed);
      let state = round;
      for (let m = 0; m < 300 && !rules.beltWon(state) && !rules.beltTrapped(state); m += 1) {
        const outcome = rules.moveBeltWaiter(state, rules.legalBeltMoves(state)[0]);
        if (outcome.ok) state = outcome.state;
      }
      if (rules.beltWon(state)) carelessWins += 1;
    }
    if (seeds.length !== wanted)
      throw new Error(
        `Tier ${tier.id}: only ${seeds.length}/${wanted} solvable seeds in ${tried} tries`,
      );
    console.log(
      `Tier ${tier.id}: ${seeds.length} proven seeds from ${tried} tries; careless play wins ${Math.round((100 * carelessWins) / seeds.length)}%`,
    );
  }
  const lines = [
    "/** Generated by scripts/make-belt-seeds.mts; every entry is solver-proven. */",
    "export const BELT_PROVEN_SEEDS_BY_TIER: Record<1 | 2 | 3 | 4, readonly number[]> = {",
    ...[1, 2, 3, 4].map((tier) => `  ${tier}: [${found[tier]!.join(", ")}],`),
    "};",
    "",
  ];
  await writeFile("src/game/business/plateSeeds.ts", lines.join("\n"), "utf8");
} finally {
  await vite.close();
}
