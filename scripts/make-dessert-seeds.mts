// Builds src/game/business/dessertSeeds.ts: per (dessert, tier), 60 plate seeds that are
//   1. PROVEN: the deck is won by the real rules in deck order, on time and with taps up to 4 s late;
//   2. RATED: a careful player (`ratePlate`, 12 rounds) finds the plate as hard as the tier's window says (RUN_HARDNESS);
//   3. ORDERED easiest first, spread evenly across the window, so a tier gets harder as the player's level climbs it (dessertRunContent.ts).
// Developer 2026-11-19: "ensure and increase the quality of the levels". Before this, a tier dealt the first 60 provable seeds: the hard picture
// (donut) decided the difficulty, not the tier.
//
// Rating takes about a second a candidate, so the rated candidates are cached in a pool folder, one file per plate, and the keys can run in
// parallel:
//   npx tsx scripts/make-dessert-seeds.mts --pool=<dir> --key=cone-4 [--candidates=360]     (one plate; run these, any number at once)
//   npx tsx scripts/make-dessert-seeds.mts --pool=<dir>                                     (writes dessertSeeds.ts from the pool files;
//                                                                                            rates any file that is missing, one by one)
// then: npx prettier --write src/game/business/dessertSeeds.ts
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { makeSeededRand } from "../src/game/business/businessDeterministicRandom.ts";
import { DESSERTS_BY_TIER, type DessertId } from "../src/game/business/dessertGallery.ts";
import {
  RUN_HARDNESS,
  RUN_TIERS,
  makeRun,
  playDeckOrder,
  ratePlate,
  runDeckProblem,
} from "../src/game/business/dessertRun.ts";

const arg = (name: string) =>
  process.argv.find((a) => a.startsWith(`--${name}=`))?.slice(name.length + 3);
const poolDir = arg("pool") ?? "scripts/.dessert-pool";
const onlyKey = arg("key");
const candidates = Number(arg("candidates") ?? 360);
const wanted = 60;
mkdirSync(poolDir, { recursive: true });

type Row = { seed: number; win: number; peak: number; stars3: number; hardness: number };

function rateKey(id: DessertId, tierId: number): Row[] {
  const tier = RUN_TIERS[tierId - 1]!;
  const file = `${poolDir}/${id}-${tierId}.json`;
  if (existsSync(file)) return JSON.parse(readFileSync(file, "utf8")) as Row[];
  const rows: Row[] = [];
  for (let candidate = 1; candidate <= candidates; candidate += 1) {
    const seed =
      (Math.imul(candidate, 0x45d9f3b) ^ Math.imul(tier.id, 0x119de1f3) ^ 0xde55e47) >>> 0;
    if (runDeckProblem(makeRun(id, seed, tier), tier) !== null) continue;
    if (!playDeckOrder(makeRun(id, seed, tier), tier).won) continue;
    const late = makeSeededRand(seed);
    if (!playDeckOrder(makeRun(id, seed, tier), tier, () => Math.floor(late() * 240)).won) continue;
    rows.push({ seed, ...ratePlate(id, seed, tier, 12) });
  }
  writeFileSync(file, JSON.stringify(rows));
  console.log(`${id} tier ${tierId}: ${rows.length} proven and rated of ${candidates}`);
  return rows;
}

if (onlyKey) {
  const [id, tierId] = onlyKey.split("-");
  rateKey(id as DessertId, Number(tierId));
  process.exit(0);
}

const lines = [
  "/** Generated by scripts/make-dessert-seeds.mts. Every seed was won by the real rules in deck order, on time and late, and rated by a careful player inside its tier's window (RUN_HARDNESS); the seeds of a plate run easiest first. */",
  "export const DESSERT_RUN_SEEDS: Record<string, readonly number[]> = {",
];
for (const tier of RUN_TIERS) {
  const [lo, hi] = RUN_HARDNESS[tier.id]!;
  for (const id of DESSERTS_BY_TIER[tier.id]) {
    const rows = rateKey(id, tier.id)
      .filter((r) => r.hardness >= lo && r.hardness <= hi)
      .sort((a, b) => a.hardness - b.hardness || a.seed - b.seed);
    if (rows.length < wanted)
      throw new Error(
        `${id} tier ${tier.id}: only ${rows.length} plates in the window ${lo}..${hi}`,
      );
    const seeds = Array.from(
      { length: wanted },
      (_, i) => rows[Math.round((i * (rows.length - 1)) / (wanted - 1))]!,
    );
    const mean = seeds.reduce((n, r) => n + r.hardness, 0) / wanted;
    console.log(
      `${id} tier ${tier.id}: ${rows.length} in the window, 60 kept, hardness ${seeds[0]!.hardness.toFixed(2)} .. ${seeds[wanted - 1]!.hardness.toFixed(2)} (mean ${mean.toFixed(2)})`,
    );
    lines.push(`  "${id}-${tier.id}": [${seeds.map((r) => r.seed).join(", ")}],`);
  }
}
lines.push("};", "");
writeFileSync("src/game/business/dessertSeeds.ts", lines.join("\n"), "utf8");
