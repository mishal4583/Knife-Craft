// Builds src/game/business/dessertSeeds.ts: per (dessert, tier), the first N plate seeds whose deck is won
// by the real rules when the waiters go in deck order, with taps on time and with taps up to 4 s late.
// Run: npx tsx scripts/make-dessert-seeds.mts [seedsPerPlate]   then: npx prettier --write src/game/business/dessertSeeds.ts
import { writeFile } from "node:fs/promises";
import { makeSeededRand } from "../src/game/business/businessDeterministicRandom.ts";
import { DESSERTS_BY_TIER } from "../src/game/business/dessertGallery.ts";
import {
  RUN_TIERS,
  makeRun,
  playDeckOrder,
  runDeckProblem,
} from "../src/game/business/dessertRun.ts";

const wanted = Number(process.argv[2] ?? 60);
const lines = [
  "/** Generated by scripts/make-dessert-seeds.mts; every seed was won by the real rules in deck order, on time and late. */",
  "export const DESSERT_RUN_SEEDS: Record<string, readonly number[]> = {",
];
for (const tier of RUN_TIERS) {
  for (const id of DESSERTS_BY_TIER[tier.id]) {
    const seeds: number[] = [];
    let tried = 0;
    for (let candidate = 1; seeds.length < wanted && candidate <= wanted * 20; candidate += 1) {
      tried += 1;
      const seed =
        (Math.imul(candidate, 0x45d9f3b) ^ Math.imul(tier.id, 0x119de1f3) ^ 0xde55e47) >>> 0;
      if (runDeckProblem(makeRun(id, seed, tier), tier) !== null) continue;
      if (!playDeckOrder(makeRun(id, seed, tier), tier).won) continue;
      const late = makeSeededRand(seed);
      if (!playDeckOrder(makeRun(id, seed, tier), tier, () => Math.floor(late() * 240)).won)
        continue;
      seeds.push(seed);
    }
    if (seeds.length !== wanted)
      throw new Error(`${id} tier ${tier.id}: ${seeds.length}/${wanted} in ${tried}`);
    console.log(`${id} tier ${tier.id}: ${seeds.length} seeds from ${tried} tries`);
    lines.push(`  "${id}-${tier.id}": [${seeds.join(", ")}],`);
  }
}
lines.push("};", "");
await writeFile("src/game/business/dessertSeeds.ts", lines.join("\n"), "utf8");
