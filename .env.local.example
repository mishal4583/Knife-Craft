# Copy this file to .env.local (already gitignored via the *.local rule)
# to enable development-only QA mode: every currently-defined campaign
# level becomes openable directly from Kitchen, bypassing the unlock
# gate, without touching real save data or the production unlock graph.
# See src/game/qaMode.ts. Only takes effect under `npm run dev`
# (import.meta.env.DEV) — never in a production `vite build`.

VITE_KNIFECRAFT_QA=true
